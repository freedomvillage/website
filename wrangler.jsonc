{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freedom-village-site-unconfigured",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "env": {
    "staging": {
      "name": "freedom-village-site-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {"DEPLOYMENT_STAGE": "staging", "AIR_ENABLED": "false", "AIR_STATION": "용산구"}
    },
    "next": {
      "name": "freedom-village-site",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {"DEPLOYMENT_STAGE": "next", "AIR_ENABLED": "false", "AIR_STATION": "용산구"}
    }
  }
}
