{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freedom-village-site-unconfigured",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/connect",
      "/connect/",
      "/give",
      "/give/",
      "/prayer",
      "/prayer/",
      "/resources",
      "/resources/",
      "/events/*",
      "/cards/*",
      "/topics/*",
      "/studies/*",
      "/api/*",
      "/media/*",
      "/robots.txt",
      "/sitemap.xml",
      "/llms.txt"
    ],
    "not_found_handling": "none"
  },
  "env": {
    "staging": {
      "name": "freedom-village-site-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "DEPLOYMENT_STAGE": "staging",
        "AIR_ENABLED": "false",
        "AIR_STATION": "용산구"
      }
    },
    "next": {
      "name": "freedom-village-site",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "DEPLOYMENT_STAGE": "next",
        "AIR_ENABLED": "true",
        "AIR_STATION": "용산구",
        "AIR_PRODUCER_ENABLED": "true",
        "AIR_DEPLOYMENT_KIND": "production",
        "CONTENT_PILOT_ENABLED": "true",
        "JEV_ENABLED": "true"
      },
      "kv_namespaces": [
        {
          "binding": "AIR_CACHE",
          "id": "058e6e2985d24f31b5e36d73bdd1ea12"
        }
      ],
      "triggers": {
        "crons": [
          "*/15 * * * *"
        ]
      },
      "previews": {
        "vars": {
          "DEPLOYMENT_STAGE": "preview",
          "AIR_ENABLED": "true",
          "AIR_PRODUCER_ENABLED": "false",
          "AIR_DEPLOYMENT_KIND": "preview",
          "AIR_STATION": "용산구"
        },
        "kv_namespaces": [
          {
            "binding": "AIR_CACHE",
            "id": "058e6e2985d24f31b5e36d73bdd1ea12"
          }
        ]
      },
      "routes": [
        {
          "pattern": "next.freedomvillage.church",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "CONTENT_DB",
          "database_name": "freedom-village-content-next",
          "database_id": "4c6e185b-e798-4ffa-9146-a40a36f0075b",
          "migrations_dir": "migrations/content"
        }
      ],
      "r2_buckets": [
        {
          "binding": "CONTENT_MEDIA",
          "bucket_name": "freedom-village-media"
        }
      ]
    }
  }
}
